# PostgreSQL configuration
MAJORDOMO_STORAGE_POSTGRES_HOST=localhost
MAJORDOMO_STORAGE_POSTGRES_PORT=5432
MAJORDOMO_STORAGE_POSTGRES_USER=majordomo
MAJORDOMO_STORAGE_POSTGRES_PASSWORD=your-postgres-password
MAJORDOMO_STORAGE_POSTGRES_DATABASE=majordomo
MAJORDOMO_STORAGE_POSTGRES_SSLMODE=disable

# S3 configuration (required when s3.enabled=true)
MAJORDOMO_S3_ACCESS_KEY_ID=your-aws-access-key
MAJORDOMO_S3_SECRET_ACCESS_KEY=your-aws-secret-key

# Secrets configuration (required for proxy keys)
# Generate with: openssl rand -hex 32
MAJORDOMO_SECRETS_ENCRYPTION_KEY=

# Web UI auth (enable admin UI/API by setting a JWT secret)
# Generate with: openssl rand -hex 32
MAJORDOMO_JWT_SECRET=

# CORS (comma-separated or JSON array). Example:
# MAJORDOMO_CORS_ALLOWED_ORIGINS=["http://localhost:5173","https://app.example.com"]
MAJORDOMO_CORS_ALLOWED_ORIGINS=

# Email (Resend) — for password reset emails
# Get API key from https://resend.com
MAJORDOMO_EMAIL_RESEND_API_KEY=
# From address, e.g. "Majordomo <no-reply@yourdomain.com>"
MAJORDOMO_EMAIL_FROM=
# Public frontend base URL used to build reset links (falls back to oauth.frontend_url or server.base_url)
MAJORDOMO_EMAIL_FRONTEND_URL=
